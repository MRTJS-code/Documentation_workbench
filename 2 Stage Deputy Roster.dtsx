    <DTS:Executable
      DTS:refId="Package\Temp FCT Merge"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{D62E7748-0133-4E5F-BD6F-B6A099897BF6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Temp FCT Merge"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Disable">@[$Project::ETL_VAR_DATA_RANGE_MODE] != "DELTA"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="-- Staging Duplication handling&#xA;WITH dupcheck as(&#xA;SELECT&#x9;&#x9;&#x9;&#x9;r.Id ,ROW_NUMBER() OVER (PARTITION BY r.Id ORDER BY r.Id) rowNum &#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.DEP_ROSTER r)&#xA;DELETE&#xA;FROM&#x9;&#x9;&#x9;&#x9;dupcheck&#xA;WHERE&#x9;&#x9;&#x9;&#x9;rowNum &gt;1&#xA;&#xA;&#xA;-- Merge Statement for temporary FCT Table&#xA;MERGE INTO&#x9;&#x9;&#x9;staging.FCT_DEP_ROSTER t&#xA;USING&#x9;&#x9;&#x9;&#x9;staging.DEP_ROSTER s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;t.Id = s.Id&#xA;WHEN MATCHED AND(&#x9;isnull(t.AreaId,0) != isnull(s.AreaId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.EmployeeId,0) != isnull(s.EmployeeId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TimesheetId,0) != isnull(s.TimesheetId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterDate,'1900-01-01') != isnull(s.RosterDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterStart,'1900-01-01') != isnull(s.RosterStart,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterEnd,'1900-01-01') != isnull(s.RosterEnd,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Hours,0) != isnull(s.Hours,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Cost,0) != isnull(s.Cost,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Comment,'') != isnull(s.Comment,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Warning,'') != isnull(s.Warning,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.WarningOverride,'') != isnull(s.WarningOverride,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.[Open],0) != isnull(s.[Open],0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Published,0) != isnull(s.Published,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.PurchaseOrder,'') != isnull(s.PurchaseOrder,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RITM,'') != isnull(s.RITM,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Creator,'') != isnull(s.Creator,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.ModifiedDate,'1900-01-01') != isnull(s.ModifiedDate,'1900-01-01'))&#xA;THEN UPDATE SET&#x9;&#x9;t.AreaId = s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.EmployeeId = s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.TimesheetId = s.TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterDate = s.RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterStart = s.RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterEnd = s.RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Hours = s.Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Cost = s.Cost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Comment = s.Comment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Warning = s.Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.WarningOverride = s.WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.[Open] = s.[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Published = s.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.PurchaseOrder = s.PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RITM = s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Creator = s.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.ModifiedDate = s.ModifiedDate&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Cost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Comment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ModifiedDate)&#xA;VALUES (&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Cost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Comment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.ModifiedDate);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Temp FCT Rebuild"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{501D3A34-E7E1-4089-A896-DAA43246E3B4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Temp FCT Rebuild"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression
        DTS:Name="Disable">@[$Project::ETL_VAR_DATA_RANGE_MODE] == "DELTA"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE @dateFrom date = ?;&#xA;&#xA;-- Staging Duplication handling&#xA;WITH dupcheck as(&#xA;SELECT&#x9;&#x9;&#x9;&#x9;r.Id ,ROW_NUMBER() OVER (PARTITION BY r.Id ORDER BY r.Id) rowNum &#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.DEP_ROSTER r)&#xA;DELETE&#xA;FROM&#x9;&#x9;&#x9;&#x9;dupcheck&#xA;WHERE&#x9;&#x9;&#x9;&#x9;rowNum &gt;1&#xA;&#xA;-- Rebuild Code&#xA;DELETE FROM staging.FCT_DEP_ROSTER&#xA;WHERE RosterDate &gt;= @dateFrom;&#xA;&#xA;INSERT INTO staging.FCT_DEP_ROSTER&#xA;SELECT * FROM staging.DEP_Roster;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_CUS_REBUILD_DATE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Truncate Staging Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{989373EB-2657-434F-A766-C3302A5894AB}"
