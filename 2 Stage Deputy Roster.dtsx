          SQLTask:SqlStatementSource="TRUNCATE TABLE staging.DEP_Roster;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
