    <DTS:Executable
      DTS:refId="Package\Maintain leave roster tracker"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DC8EAEB1-D570-4819-895B-6A197CCFB912}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Maintain leave roster tracker"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;@runType varchar(10) = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;@rebuildDate date = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;@runDate date = ?;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;r.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;r.Id RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;r.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;r.RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;r.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;r.ModifiedDate&#xA;INTO&#x9;&#x9;&#x9;&#x9;#RosterSource&#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.DEP_Roster r&#xA;WHERE&#x9;&#x9;&#x9;&#x9;r.EmployeeId &gt; 0;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;ea.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ll.Id LeaveLineId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ll.LeaveDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;ll.Modified&#xA;INTO&#x9;&#x9;&#x9;&#x9;#LeaveSource&#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.DEP_LeaveLine ll&#xA;INNER JOIN&#x9;&#x9;&#x9;staging.DEP_EmployeeAgreement ea on ll.AgreementId = ea.agreementId;&#xA;&#xA;-- Mark as deleted if not matched by roster id and remove anything prior to the rebuild date.  Only possible on FIXED runs after the rebuild date.&#xA;IF @runType = 'FIXED' &#xA;BEGIN&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;r.Id&#xA;INTO&#x9;&#x9;&#x9;&#x9;#rebuildSource&#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.FCT_DEP_ROSTER r&#xA;WHERE&#x9;&#x9;&#x9;&#x9;r.RosterDate &gt;= @rebuildDate;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;lookup.DEP_LeaveRosterTracker t&#xA;USING&#x9;&#x9;&#x9;&#x9;#rebuildSource s ON t.RosterId = s.Id&#xA;WHEN NOT MATCHED BY SOURCE &#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_DeleteDate is NULL&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterDate &gt;= @rebuildDate THEN&#xA;UPDATE SET&#x9;&#x9;&#x9;t.MD_DeleteDate = @runDate;&#xA;&#xA;DELETE FROM&#x9;&#x9;&#x9;lookup.DEP_LeaveRosterTracker&#xA;WHERE&#x9;&#x9;&#x9;&#x9;RosterDate &lt; @rebuildDate;&#xA;&#xA;END&#xA;&#xA;-- Add New records&#xA;MERGE INTO&#x9;&#x9;&#x9;lookup.DEP_LeaveRosterTracker t&#xA;USING&#x9;&#x9;&#x9;&#x9;#RosterSource s ON t.RosterId = s.RosterId AND t.EmployeeId = s.EmployeeId&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_PublishDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate)&#xA;VALUES (&#x9;&#x9;&#x9;s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE s.Published WHEN 1 THEN s.ModifiedDate ELSE NULL END,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.ModifiedDate)&#xA;&#xA;WHEN MATCHED AND (&#x9;t.AreaId != s.AreaId OR t.RosterDate != s.RosterDate &#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;CASE WHEN t.MD_PublishDate IS NULL THEN 0 ELSE 1 END != s.Published) THEN&#xA;UPDATE SET&#x9;&#x9;&#x9;t.AreaId = s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterDate = s.RosterDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveLineId = CASE WHEN t.RosterDate != s.RosterDate AND t.LeaveLineId is NOT NULL THEN NULL ELSE t.LeaveLineId END,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_PublishDate = CASE WHEN s.Published = 1 AND t.MD_PublishDate is NULL THEN s.ModifiedDate &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Published = 0 AND t.MD_PublishDate is NOT NULL THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE t.MD_PublishDate END;&#xA;&#xA;-- Add leave line ID if approved leave found with a match to roster + update removed date&#xA;UPDATE&#x9;&#x9;&#x9;&#x9;t&#xA;SET&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveLineId = s.LeaveLineId&#xA;FROM&#x9;&#x9;&#x9;&#x9;lookup.DEP_LeaveRosterTracker t&#xA;INNER JOIN&#x9;&#x9;&#x9;#LeaveSource s ON t.EmployeeId = s.employeeId AND t.RosterDate = s.LeaveDate;&#xA;&#xA;-- Mark as removed if not matched by roster and employee&#xA;UPDATE&#x9;&#x9;&#x9;&#x9;t&#xA;SET&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_RemovedDate = s.ModifiedDate&#xA;FROM&#x9;&#x9;&#x9;&#x9;lookup.DEP_LeaveRosterTracker t&#xA;INNER JOIN&#x9;&#x9;&#x9;#RosterSource s ON t.RosterId = s.RosterId&#xA;WHERE&#x9;&#x9;&#x9;&#x9;t.EmployeeId != s.EmployeeId&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_DeleteDate is NULL;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_DATA_RANGE_MODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="10" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_CUS_REBUILD_DATE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_DATE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
