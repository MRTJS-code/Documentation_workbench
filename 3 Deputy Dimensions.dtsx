    <DTS:Executable
      DTS:refId="Package\DIM_GUARDAGREEHISTORY"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{FD77B3C9-32CB-4285-8BD2-42A042707714}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_GUARDAGREEHISTORY"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;a.*,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;DATEADD(SECOND,-1, Lead(a.CreateDate) OVER  (PARTITION BY AgreementId ORDER BY AgreementId, CreateDate)) EndDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;e.SK_DIM_EMPLOYEE FK_DIM_EMPLOYEE&#xA;INTO&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;staging.DEP_AGREEHISTORY a&#xA;LEFT JOIN&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE e ON a.PayrollId = e.PK_PR_ID_Number&#xA;ORDER BY&#x9;&#x9;&#x9;AgreementId, CreateDate;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;dw.DIM_GUARDAGREEHIST t&#xA;USING&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_DeputyId = s.AgreeHistId&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;PK_DeputyId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_GUARDAGREEMENT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AgreePayrollId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeDateFrom,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeDateTo,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;s.AgreeHistId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AgreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.PayrollId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Active,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.StartDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.EndDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.CreatedUser);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DIM_GUARDAGREEMENT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{314FE491-319E-4051-9A74-918EF602D157}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_GUARDAGREEMENT"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;a.agreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(g.SK_DIM_SECURITYGUARD,0) FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.SK_DIM_EMPLOYEE FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;pc.Name PayCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(a.contractName, 'No Contract') ContractName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE a.employeeBasis&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 1 THEN 'Employee'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 2 THEN 'Labour Hire'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'Unknown'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END EmpBasis,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE a.employeeCategory&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 1 THEN 'Permanent'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 2 THEN 'Temporary'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'Unknown'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END EmpCat,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE a.employeeStatus&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 1 THEN 'Full Time'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 2 THEN 'Part Time'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 3 THEN 'Casual'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 4 THEN 'Contractor'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'Unknown'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END EmpStatus,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Cast(a.employeeCondition as varchar(100)) EmpCond,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.modifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.createdDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.payrollId&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_EmployeeAgreement a&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_SECURITYGUARD g ON a.employeeId = g.PK_SourceId AND g.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location pc ON a.payCentreId = pc.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE e ON a.payrollId = e.PK_PR_ID_Number AND e.PK_DW_Source_System = 'Preceda'&#xA;ORDER BY&#x9;&#x9;&#x9;&#x9;a.employeeId, a.agreementId&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_GUARDAGREEMENT t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourcebuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_DeputyId = s.agreementId&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_SECURITYGUARD,0) != isnull(s.FK_DIM_SECURITYGUARD,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_EMPLOYEE,0) != isnull(s.FK_DIM_EMPLOYEE,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeGuardId,0) != isnull(s.employeeId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeStartDate,'1900-01-01') != isnull(s.startDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreePayCentre,'') != isnull(s.PayCentre,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeContract,'') != isnull(s.ContractName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeEmpBasis,'') != isnull(s.EmpBasis,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeEmpCategory,'') != isnull(s.EmpCat,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeEmpStatus,0) != isnull(s.EmpStatus,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeEmpCondition,'') != isnull(s.EmpCond,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreeActive,0) != isnull(s.isActive,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AgreePayrollId,'') != isnull(s.PayrollId,''))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_SECURITyGUARD = s.FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_EMPLOYEE = s.FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeGuardId = s.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeStartDate = s.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreePayCentre = s.PayCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeContract = s.ContractName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeEmpBasis = s.EmpBasis,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeEmpCategory = s.EmpCat,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeEmpStatus = s.EmpStatus,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeEmpCondition = s.EmpCond,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreeActive = s.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.modifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRun = @ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AgreePayrollId = s.PayrollId&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;&#x9;PK_DeputyId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeGuardId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeStartDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreePayCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeContract,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeEmpBasis,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeEmpCategory,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeEmpStatus,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeEmpCondition,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreeActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AgreePayrollId)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;s.agreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_EMPLOYEE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.PayCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.ContractName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmpBasis,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmpCat,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmpStatus,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmpCond,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.createdDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.modifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.PayrollId);&#xA;&#xA;&#xA;-- Duplicate Agreement Handler otherwise FACTS will duplicate&#xA;UPDATE&#x9;&#x9;&#x9;&#x9;&#x9;a&#xA;SET&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.AgreeActive = 0&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;dw.DIM_GUARDAGREEMENT a&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_SECURITYGUARD g ON a.FK_DIM_SECURITYGUARD = g.SK_DIM_SECURITYGUARD&#xA;WHERE&#x9;&#x9;&#x9;&#x9;&#x9;a.AgreePayCentre Not Like '%Timesheet%'&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.AgreeActive = 1&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;g.GuardActive = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
