    <DTS:Executable
      DTS:refId="Package\DIM_SECURITYGUARD"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9A844EB4-FA16-4069-BBC1-16F9C20D942A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_SECURITYGUARD"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?; &#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;e.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.Company locationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.login,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.coa,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.firstName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.lastName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.terminationDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.dateOfBirth,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.employer,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.displayName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;e.sendInvite invited,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.Role,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ebl.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;coalesce(d1.SK_DIM_DEPOT, d2.SK_DIM_DEPOT, 0) FK_DIM_DEPOT&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_Employee e&#xA;INNER JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_EmployeeBranchLocation ebl on e.employeeId = ebl.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_DEPOT d1 ON ebl.Company = d1.PK_SourceId AND d1.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_CLIENTLOCATION l ON ebl.Company = l.PK_SystemId AND l.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_DEPOT d2 ON l.FK_DIM_DEPOT = d2.SK_DIM_DEPOT AND l.PK_SourceSystem = 'Deputy' AND d2.PK_SourceSystem = 'Deputy'&#xA;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_SECURITYGUARD t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_SourceId = s.employeeId and t.PK_SourceSystem = 'Deputy'&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_Depot,0) != isnull(s.FK_DIM_DEPOT,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.GuardLocationId,0) != isnull(s.locationId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LoginId,'') != isnull(s.login,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.COA,'') != isnull(s.coa,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FirstName,'') != isnull(s.firstName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LastName,'') != isnull(s.lastName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.HireDate,'1900-01-01') != isnull(s.startDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TerminationDate,'1900-01-01') != isnull(s.terminationDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.BirthDate,'1900-01-01') != isnull(s.dateOfBirth,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Employer,'') != isnull(s.employer,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DisplayName,'') != isnull(s.displayName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Invited,0) != isnull(s.invited,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.GuardActive,0) != isnull(s.isActive,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.GuardRole,'') != isnull(s.Role,''))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_Depot = s.FK_DIM_DEPOT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.GuardLocationId = s.locationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LoginId = s.login,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.COA = s.coa,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FirstName = s.firstName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LastName = s.lastName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.HireDate = s.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TerminationDate = s.terminationDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.BirthDate = s.dateOfBirth,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Employer = s.employer,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DisplayName = s.displayName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Invited = s.invited,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.GuardActive = s.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.GuardRole = s.Role,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRun = @ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator&#xA;&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;&#x9;PK_SourceId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;PK_SourceSystem,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_Depot,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GuardLocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LoginId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;COA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FirstName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LastName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;HireDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;TerminationDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;BirthDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Employer,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DisplayName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Invited,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GuardActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;GuardRole,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;s.employeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;'Deputy',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_DEPOT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.locationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.login,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.coa,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.firstName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.lastName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.startDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.terminationDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.dateOfBirth,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.employer,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.displayName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.invited,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.isActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Role,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
