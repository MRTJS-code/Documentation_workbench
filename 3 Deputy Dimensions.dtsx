    <DTS:Executable
      DTS:refId="Package\DIM_LEAVETYPE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4A7149B4-235E-49ED-A3D1-11BC787EEEC4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_LEAVETYPE"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?;&#xA;&#xA;WITH qry AS (&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;r.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Name LeaveName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CHARINDEX('|',r.PayrollCategory) != 0 THEN REVERSE(PARSENAME(REPLACE(REVERSE(r.PayrollCategory), '|', '.'), 1))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.PayrollCategory&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END as varchar(50)) LeavePayCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CHARINDEX('|',r.PayrollCategory) != 0 THEN REVERSE(PARSENAME(REPLACE(REVERSE(r.PayrollCategory), '|', '.'), 2))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END as varchar(50)) LeaveActivtyCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.PaidLeave LeavePayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Visible LeaveVisible,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE r.UnitType&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 0 THEN 'Hours'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 1 THEN 'Days'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 'Unknown'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LeaveUnit,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Modified&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_LeaveRules r)&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;qry.*,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(c.SK_DIM_Paycode,0) FK_DIM_PAYCODE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(a.SK_DIM_Cost_Activity,0) FK_DIM_COST_ACTIVITY&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;qry&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_PAYCODE c ON qry.LeavePayCode = c.PK_PR_Code AND c.PK_DW_Source_System = 'Preceda'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_COST_ACTIVITY a ON qry.LeaveActivtyCode = a.P_Code&#xA;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_LEAVETYPE t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Id = t.PK_SourceId AND t.PK_SourceSystem = 'Deputy'&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_PAYCODE,0) != isnull(s.FK_DIM_PAYCODE,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_COST_ACTIVITY,0) != isnull(s.FK_DIM_COST_ACTIVITY,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveName,'') != isnull(s.LeaveName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveActivityCode,'') != isnull(s.LeaveActivtyCode,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeavePayCode,'') != isnull(s.LeavePayCode,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeavePayroll,0)!= isnull(s.LeavePayroll,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveVisible,0) != isnull(s.LeaveVisible,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveUnit,0) != isnull(s.LeaveUnit,0))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_PAYCODE = s.FK_DIM_PAYCODE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_COST_ACTIVITY = s.FK_DIM_COST_ACTIVITY,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveName = s.LeaveName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveActivityCode = s.LeaveActivtyCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeavePayCode = s.LeavePayCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeavePayroll = s.LeavePayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveVisible = s.LeaveVisible,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveActive = 1,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveUnit = s.LeaveUnit,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_CreateDate = s.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRun = @ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator&#xA;&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;&#x9;PK_SourceSystem,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;PK_SourceId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_PAYCODE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_COST_ACTIVITY,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveActivityCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeavePayCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeavePayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveVisible,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveUnit,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;'Deputy',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_PAYCODE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_COST_ACTIVITY,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveActivtyCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeavePayCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeavePayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveVisible,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;1,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveUnit,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="$Project::ETL_VAR_EXECUTION_ID"
