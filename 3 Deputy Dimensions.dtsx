  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\DIM_AREA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AA1024CA-89EB-464F-B429-377BACBE9285}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_AREA"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@runDate datetime = SYSDATETIME();&#xA;&#xA;WITH qry AS (&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;a.Id AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.Name AreaName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.Active AreaActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CHARINDEX('|',a.PayrollExportName) != 0 THEN REVERSE(PARSENAME(REPLACE(REVERSE(a.PayrollExportName), '|', '.'), 1))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE a.PayrollExportName&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CostCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CHARINDEX('|',a.PayrollExportName) != 0 THEN REVERSE(PARSENAME(REPLACE(REVERSE(a.PayrollExportName), '|', '.'), 2))&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END ProductCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.Modified&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_AREA a&#xA;)&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;qry.*,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(l.SK_DIM_CLIENTLOCATION,0) FK_DIM_CLIENTLOCATION,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;la.PayRate SiteRate&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;qry&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_CLIENTLOCATION l ON qry.LocationId = l.PK_SystemId AND l.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;lookup.DEP_WorkAreas la ON qry.AreaId = la.PK_WorkAreaID AND la.EffectiveFrom &lt;= @runDate AND isnull(la.EffectiveTo, @runDate) &gt;= @runDate&#xA;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_AREA t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaId = t.PK_DeputyId&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_Location,0) != isnull(s.FK_DIM_CLIENTLOCATION,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaLocationId,0) != isnull(s.LocationId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaName,'') != isnull(s.AreaName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaActive,0) != isnull(s.AreaActive,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaCostCentre,'') != isnull(s.CostCentre,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaProduct,'') != isnull(s.ProductCode,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaSiteRate,0) != isnull(s.SiteRate,0))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_Location = s.FK_DIM_CLIENTLOCATION,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaLocationId = s.LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaName = s.AreaName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaActive = s.AreaActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaCostCentre = s.CostCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaProduct = s.ProductCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaSiteRate = s.SiteRate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRun = @ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator&#xA;&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;&#x9;PK_DeputyId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_Location,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaLocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaCostCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaProduct,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AreaSiteRate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_CLIENTLOCATION,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.CostCentre,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.ProductCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.SiteRate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="$Project::ETL_VAR_EXECUTION_ID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DIM_CLIENTLOCATION"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8B05E896-E2B2-47F9-BA83-C9873E550309}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_CLIENTLOCATION"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;&#xA;WITH qry AS (&#xA;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Id &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Code &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Code &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.CompanyNumber LocationDebtor,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.isWorkplace,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.isPayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.Active LocationActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyName&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_Location l&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location b ON l.ParentId = b.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location r ON b.ParentId = r.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location c ON r.ParentId = c.Id&#xA;)&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationDebtor,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(d.SK_DIM_DEPOT,0) FK_DIM_DEPOT&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;qry&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_DEPOT d ON qry.BranchId = d.PK_SourceId AND d.PK_SourceSystem = 'Deputy'&#xA;WHERE&#x9;&#x9;&#x9;&#x9;&#x9;qry.LocationId is not null&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;qry.CompanyId = 1&#xA;ORDER BY&#x9;&#x9;&#x9;&#x9;qry.isPayroll DESC,  qry.CompanyName, qry.RegionName, qry.BranchName, qry.LocationName;&#xA;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_CLIENTLOCATION t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_SystemId = s.LocationId AND t.PK_SourceSystem = 'Deputy'&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_DEPOT,0) != isnull(s.FK_DIM_DEPOT,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LocDepotId,0) != isnull(s.BranchId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LocCode,'') != isnull(s.LocationCode,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LocName,'') != isnull(s.LocationName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LocDebtorCode,'') != isnull(s.LocationDebtor,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LocActive,0) != isnull(s.LocationActive,0))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_DEPOT = s.FK_DIM_DEPOT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LocDepotId = s.BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LocCode = s.LocationCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LocName = s.LocationName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LocDebtorCode = s.LocationDebtor,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.LocActive = s.LocationActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;&#x9;PK_SourceSystem,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;PK_SystemId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_DEPOT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LocDepotId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LocCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LocName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LocDebtorCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LocActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;'Deputy',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_DEPOT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationDebtor,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.LocationActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator)&#xA;&#xA;WHEN NOT MATCHED BY SOURCE&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.LocActive = 0,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = SYSDATETIME(),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DIM_DEPOT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{026F05D7-3754-432F-9C3F-05958D3FF7B2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_DEPOT"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;&#xA;&#xA;WITH qry AS (&#xA;SELECT&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Id &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Code &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Code &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Code&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.CompanyNumber LocationDebtor,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.isWorkplace,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l.isPayroll,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;b.Active BranchActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE l.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END LocationName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE b.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END BranchName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 THEN l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 THEN b.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE r.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END RegionName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN l.ParentId = 0 then l.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN b.ParentId = 0 then b.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.ParentId = 0 then r.Name&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE c.Name &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END CompanyName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;b.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;b.Modified&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_Location l&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location b ON l.ParentId = b.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location r ON b.ParentId = r.Id&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;staging.DEP_Location c ON r.ParentId = c.Id&#xA;)&#xA;SELECT&#x9;DISTINCT&#x9;&#x9;qry.BranchId, qry.BranchName, qry.RegionName, qry.CompanyName, qry.isPayroll,isnull(db.SKDIM_Branch,0) FK_DIM_Branch, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(db.SKDIM_Region,0) FK_DIM_Region, qry.BranchActive, md.Creator, md.Modified&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;qry&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;lookup.DEP_DEPOTBRANCH db ON qry.BranchId = db.DepBranchId&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;(SELECT Id, Creator, Modified FROM staging.DEP_Location) md ON qry.BranchId = md.Id&#xA;WHERE&#x9;&#x9;&#x9;&#x9;&#x9;qry.BranchId is NOT NULL&#xA;ORDER BY&#x9;&#x9;&#x9;&#x9;qry.isPayroll DESC,  qry.CompanyName, qry.RegionName, qry.BranchName;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.DIM_DEPOT t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_SourceId = s.BranchId AND t.PK_SourceSystem = 'Deputy'&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_BRANCH,0) != isnull(s.FK_DIM_Branch,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_Region,0) != isnull(s.FK_DIM_Region,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DepotRegion,'') != isnull(s.RegionName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DepotCompany,'') != isnull(s.CompanyName,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DepotActive,0) != isnull(s.BranchActive,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DepotName,'') != isnull(s.BranchName,''))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_BRANCH = s.FK_DIM_Branch,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_Region = s.FK_DIM_Region,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DepotRegion = s.RegionName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DepotCompany = s.CompanyName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DepotActive = s.BranchActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DepotName = s.BranchName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator&#xA;&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;&#x9;PK_SourceSystem,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;PK_SourceId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_BRANCH,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_REGION,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DepotRegion,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DepotCompany,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DepotActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DepotName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;'Deputy',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.BranchId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_Branch,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_Region,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.RegionName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.CompanyName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.BranchActive,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.BranchName,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Project::ETL_VAR_RUN_CODE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
