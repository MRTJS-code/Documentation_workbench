        /*
        public string Email1Type { get; set; }
        public object Email2Type { get; set; }
        public object Email2 { get; set; }
        public int PrimaryEmail { get; set; }
        public object Im1 { get; set; }
        public object Im2 { get; set; }
        public object Im1Type { get; set; }
        public object Im2Type { get; set; }
