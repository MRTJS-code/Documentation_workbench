    <DTS:Executable
      DTS:refId="Package\Merge staging FCT_DEP_EmployeePaycycle"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{01531467-AC71-4A6C-8978-F3B49C575ECD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Merge staging FCT_DEP_EmployeePaycycle"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@rebuildDate date = ?&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;staging.FCT_DEP_EmployeePaycycle t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_EmployeePaycycle s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Id = s.Id&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;&#x9;Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   ,PeriodId&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   ,Modified)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;s.Id&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   ,s.PeriodId&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   ,s.Modified)&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.PeriodId,0) != isnull(s.PeriodId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Modified,0) != isnull(s.Modified,0))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.PeriodId = s.PeriodId&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;   ,t.Modified = s.Modified&#xA;&#xA;WHEN NOT MATCHED BY SOURCE &#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Modified &gt;= @rebuildDate&#xA;THEN DELETE;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_CUS_REBUILD_DATE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
