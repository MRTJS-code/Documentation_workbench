        public string CustomPronouns { get; set; }
    }

    public class DPMetaData
    {
        public string System { get; set; }
        public CreatorInfo CreatorInfo { get; set; }
    }
    */
    public class ModuleObject
    {
        //public int Id { get; set; }
        public string Title { get; set; }
        public string Provider { get; set; }
        /*
        public int? ProviderAddress { get; set; }
        public int? Cost { get; set; }
        public int TimeRequiredDays { get; set; }
        public int? RenewalPeriodMonths { get; set; }
        public string Comment { get; set; }
        public int Creator { get; set; }
        public DateTime Created { get; set; }
        public DateTime Modified { get; set; }
        public DPMetaData _DPMetaData { get; set; }
        */
    }

    public class Training
    {
        public int Id { get; set; }
        public int Employee { get; set; }
        public int Module { get; set; }
        public DateTime TrainingDate { get; set; }
        public DateTime? ExpiryDate { get; set; }
        public bool Active { get; set; }
        public string Comment { get; set; }
        /*
        public object File { get; set; }
        public int Creator { get; set; }
        public DateTime Created { get; set; }
        public DateTime Modified { get; set; }
        public DPMetaData _DPMetaData { get; set; }
        */
        public ModuleObject ModuleObject { get; set; }
    }
    #endregion
}
