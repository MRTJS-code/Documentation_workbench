  <diagram name="SSIS Workflow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="SSIS Package into ETL Job Code 6000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="800" height="360" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Handler runs every minute (async to processors; can be predecessor if issues)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Events with WAIT status found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Scheduled date &lt; system datetime?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Update event status to NEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="140" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7" value="No action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="670" y="140" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Events with NEW or RETRY status found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="240" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Scheduled date is null or &lt; system datetime?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="245" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Check processor ETL job status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="500" y="255" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="11" value="In Progress → No action (processor active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Ready + kickoff &lt; now → No action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="285" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Ready + kickoff &gt; now → Update config to run minutely at current time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Error → Update event status to ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="420" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Other status → No action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="475" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="16" value="SSIS Package into ETL Job Code 6001" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="800" height="360" as="geometry" />
        </mxCell>
        <mxCell id="17" value="If no events found, deputy processor updates its job config to run daily at 1am next day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="18" value="SSIS maintenance job added for EDA hygiene tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Deputy processor no longer clears extract tables every run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="20" value="EDA Hygiene (daily at midnight):&lt;br&gt;• Annual LKP_PHTRACKER maintenance (10 Jan)&lt;br&gt;• If processors not active, set kickoff to 1am tomorrow&lt;br&gt;• Remove event records &gt; 28 days old&lt;br&gt;• Remove extract/import data &gt; 4 days old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
