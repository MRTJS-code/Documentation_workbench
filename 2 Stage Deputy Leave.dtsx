          SQLTask:SqlStatementSource="MERGE INTO&#x9;&#x9;&#x9;&#x9;staging.FCT_DEP_LEAVE t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_Leave s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Id = s.Id&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.DateStart,0) != isnull(s.DateStart,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.DateEnd,0) != isnull(s.DateEnd,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Days,0) != isnull(s.Days,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TotalHours,0) != isnull(s.TotalHours,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Status,0) != isnull(s.Status,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Modified,0) != isnull(s.Modified,0))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.DateStart = s.DateStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.DateEnd = s.DateEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Days = s.Days,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TotalHours = s.TotalHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Status = s.Status,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Modified = s.Modified&#xA;WHEN NOT MATCHED&#xA;THEN INSERT&#x9;(&#x9;&#x9;&#x9;Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DateStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;DateEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Days,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;TotalHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Status,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;Modified)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.DateStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.DateEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Days,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.TotalHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Status,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified);&#xA;&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;staging.FCT_DEP_LEAVELINE t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_LeaveLine s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Id = s.Id&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.LeaveId,0) != isnull(s.LeaveId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveRuleId,0) != isnull(s.LeaveRuleId,0)&#xA;OR&#x9;&#x