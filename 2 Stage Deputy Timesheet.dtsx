        DTS:Name="Disable">@[$Project::ETL_VAR_DATA_RANGE_MODE] != "DELTA"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;@defaultDateTime datetime = '1955-05-05 05:55';&#xA;&#xA;-- Duplication handler&#xA;WITH DUPCHECK as (&#xA;SELECT t.Id, ROW_NUMBER() OVER (PARTITION BY t.Id ORDER BY t.Id) rowNum&#xA;FROM staging.DEP_Timesheet t)&#xA;DELETE FROM DUPCHECK WHERE rowNum &gt; 1&#xA;&#xA;&#xA;-- Merge Code&#xA;MERGE INTO&#x9;&#x9;&#x9;staging.FCT_DEP_TIMESHEET t&#xA;USING&#x9;&#x9;&#x9;&#x9;staging.DEP_Timesheet s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;t.Id = s.Id&#xA;WHEN NOT MATCHED THEN&#xA;INSERT (&#x9;&#x9;&#x9;Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AgreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveRuleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;LeaveId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;PayCycleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;JobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;timesheetStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;timesheetEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;timesheetHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;timesheetCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;SourceType,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;InProgress,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RealTime,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AutoProcessed,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;PayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;TimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AutoPayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;AutoTimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Exported,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Paid,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Invoiced,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;InvoiceComment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Discarded,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;PONumber,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;EMSMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;NCRMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Modified)&#xA;VALUES (&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AgreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveRuleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.LeaveId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.PayCycleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.JobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.timesheetStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.timesheetEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.timesheetHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.timesheetCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.SourceType,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.InProgress,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RealTime,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AutoProcessed,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.PayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.TimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AutoPayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.AutoTimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Exported,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Paid,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Invoiced,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.InvoiceComment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Discarded,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.PONumber,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.EMSMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.NCRMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;s.Modified )&#xA;WHEN MATCHED AND (&#x9;isnull(t.AgreementId,0) != isnull(s.AgreementId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.EmployeeId,0) != isnull(s.EmployeeId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveRuleId,0) != isnull(s.LeaveRuleId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.LeaveId,0) != isnull(s.LeaveId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.PayCycleId,0) != isnull(s.PayCycleId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AreaId,0) != isnull(s.AreaId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterId,0) != isnull(s.RosterId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.JobCode,'') != isnull(s.JobCode,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.timesheetStart,@defaultDateTime) != isnull(s.timesheetStart,@defaultDateTime)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.timesheetEnd,@defaultDateTime) != isnull(s.timesheetEnd,@defaultDateTime)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.timesheetHours,0) != isnull(s.timesheetHours,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.timesheetCost,0) != isnull(s.timesheetCost,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.SourceType,'') != isnull(s.SourceType,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.InProgress,0) != isnull(s.InProgress,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RealTime,0) != isnull(s.RealTime,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AutoProcessed,0) != isnull(s.AutoProcessed,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.PayApproved,0) != isnull(s.PayApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TimeApproved,0) != isnull(s.TimeApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AutoPayApproved,0) != isnull(s.AutoPayApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.AutoTimeApproved,0) != isnull(s.AutoTimeApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Exported,0) != isnull(s.Exported,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Paid,0) != isnull(s.Paid,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Invoiced,0) != isnull(s.Invoiced,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.InvoiceComment,'') != isnull(s.InvoiceComment,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Discarded,0) != isnull(s.Discarded,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.PONumber,'') != isnull(s.PONumber,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RITM,'') != isnull(s.RITM,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.EMSMinutes,0) != isnull(s.EMSMinutes,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.NCRMinutes,0) != isnull(s.NCRMinutes,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.Modified,0) != isnull(s.Modified,0)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;) THEN&#xA;UPDATE SET&#x9;&#x9;&#x9;t.AgreementId = s.AgreementId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.EmployeeId = s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveRuleId = s.LeaveRuleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.LeaveId = s.LeaveId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.PayCycleId = s.PayCycleId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.AreaId = s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterId = s.RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.JobCode = s.JobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetStart = s.timesheetStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetEnd = s.timesheetEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetHours = s.timesheetHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetCost = s.timesheetCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.SourceType = s.SourceType,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.InProgress = s.InProgress,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RealTime = s.RealTime,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.AutoProcessed = s.AutoProcessed,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.PayApproved = s.PayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.TimeApproved = s.TimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.AutoPayApproved = s.AutoPayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.AutoTimeApproved = s.AutoTimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Exported = s.Exported,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Paid = s.Paid,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Invoiced = s.Invoiced,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.InvoiceComment = s.InvoiceComment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Discarded = s.Discarded,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.PONumber = s.PONumber,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.RITM = s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.EMSMinutes = s.EMSMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.NCRMinutes = s.NCRMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;t.Modified = s.Modified;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
