                      dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* The Script Component allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services data flow.
 *
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script component. */
#endregion

#region Namespaces
using System;
using System.Collections.Generic;
using System.Data;
using System.Net;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Threading.Tasks;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

/// <summary>
/// This is the class to which to add your code.  Do not change the name, attributes, or parent
/// of this class.
/// </summary>
[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    #region Help:  Using Integration Services variables and parameters
    /* To use a variable in this script, first ensure that the variable has been added to
     * either the list contained in the ReadOnlyVariables property or the list contained in
     * the ReadWriteVariables property of this script component, according to whether or not your
     * code needs to write into the variable.  To do so, save this script, close this instance of
     * Visual Studio, and update the ReadOnlyVariables and ReadWriteVariables properties in the
     * Script Transformation Editor window.
     * To use a parameter in this script, follow the same steps. Parameters are always read-only.
     *
     * Example of reading from a variable or parameter:
     *  DateTime startTime = Variables.MyStartTime;
     *
     * Example of writing to a variable:
     *  Variables.myStringVariable = "new value";
     */
    #endregion

    #region Help:  Using Integration Services Connnection Managers
    /* Some types of connection managers can be used in this script component.  See the help topic
     * "Working with Connection Managers Programatically" for details.
     *
     * To use a connection manager in this script, first ensure that the connection manager has
     * been added to either the list of connection managers on the Connection Managers page of the
     * script component editor.  To add the connection manager, save this script, close this instance of
     * Visual Studio, and add the Connection Manager to the list.
     *
     * If the component needs to hold a connection open while processing rows, override the
     * AcquireConnections and ReleaseConnections methods.
     * 
     * Example of using an ADO.Net connection manager to acquire a SqlConnection:
     *  object rawConnection = Connections.SalesDB.AcquireConnection(transaction);
     *  SqlConnection salesDBConn = (SqlConnection)rawConnection;
     *
     * Example of using a File connection manager to acquire a file path:
     *  object rawConnection = Connections.Prices_zip.AcquireConnection(transaction);
     *  string filePath = (string)rawConnection;
     *
     * Example of releasing a connection manager:
     *  Connections.SalesDB.ReleaseConnection(rawConnection);
     */
    #endregion

    #region Help:  Firing Integration Services Events
    /* This script component can fire events.
     *
     * Example of firing an error event:
     *  ComponentMetaData.FireError(10, "Process Values", "Bad value", "", 0, out cancel);
     *
     * Example of firing an information event:
     *  ComponentMetaData.FireInformation(10, "Process Values", "Processing has started", "", 0, fireAgain);
     *
     * Example of firing a warning event:
     *  ComponentMetaData.FireWarning(10, "Process Values", "No rows were received", "", 0);
     */
    #endregion

    /// <summary>
    /// This method is called once, before rows begin to be processed in the data flow.
    ///
    /// You can remove this method if you don't need to do anything here.
    /// </summary>
    public override void PreExecute()
    {
        base.PreExecute();
        /*
         * Add your code here
         */
    }

    /// <summary>
    /// This method is called after all the rows have passed through this component.
    ///
    /// You can delete this method if you don't need to do anything here.
    /// </summary>
    public override void PostExecute()
    {
        base.PostExecute();
        /*
         * Add your code here
         */
    }

    public override void CreateNewOutputRows()
    {
        try
        {
            // Log the value of the variable
            string token = Variables.ENVCONNECTION1DEPTOKEN.ToString();
            string apiCall = "/api/v1/resource/Timesheet/QUERY";
            string url = Variables.ENVCONNECTION1DEPURL.ToString() + apiCall;
            string timeZone = "New Zealand Standard Time";
            string sourceTimeZone = TimeZone.CurrentTimeZone.StandardName;
            string rangeMode = Variables.ETLVARDATARANGEMODE;
            string rebuildDate = Variables.ETLCUSREBUILDDATE;
            DateTime deltaDate = ConvertTimeZone(Variables.DeltaModified, sourceTimeZone, timeZone);

            bool fireAgain = false;

            ServicePointManager.SecurityProtocol = SecurityProtocolType.Ssl3 | SecurityProtocolType.Tls | SecurityProtocolType.Tls11 | SecurityProtocolType.Tls12;

            // Create an HttpClient
            using (HttpClient client = new HttpClient())
            {
                // Set the Bearer token in the Authorization header
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                client.DefaultRequestHeaders.ExpectContinue = false;
                client.DefaultRequestHeaders.Add("Connection", "Keep-Alive");
                client.Timeout = TimeSpan.FromSeconds(60);

                //create flow variables
                int start = 0;
                bool moreRecords = true;

                while (moreRecords)
                {
                    string requestUrl = url;
                    string reqBody = "{\n";
                    reqBody += "\"search\": {\n";
                    if (rangeMode == "DELTA") reqBody += "\"s1\":{\"field\":\"Modified\", \"data\":\"" + deltaDate.AddSeconds(-10).ToString("yyyy-MM-dd hh:mm:ss") + "\", \"type\":\"ge\"}\n";
                    else reqBody += "\"s1\":{\"field\":\"Date\", \"data\":\"" + rebuildDate + "\", \"type\":\"ge\"}\n";
                    reqBody += "}\n";
                    reqBody += ",\"start\":" + start.ToString() + "\n";
                    reqBody += ",\"sort\":{\"Id\": \"asc\"}\n";
                    reqBody += ",\"join\": [\"Leave\", \"CustomFieldDataObject\", \"OperationalUnitObject\"]\n";
                    reqBody += "}";

                    this.ComponentMetaData.FireInformation(0, "API Body", reqBody, "", 0, ref fireAgain);

                    JavaScriptSerializer sr = new JavaScriptSerializer();
                    sr.MaxJsonLength = 5097152;

                    StringContent requestContent = new StringContent(reqBody, System.Text.Encoding.UTF8, "application/json");
                    HttpResponseMessage depResponse = apiRequest(client, requestUrl, requestContent).Result;

                    // Check if the request was successful
                    if (depResponse.IsSuccessStatusCode)
                    {
                        string responseBody = depResponse.Content.ReadAsStringAsync().Result;

                        // Deserialize the JSON response
                        List<Timesheet> apiResponse = sr.Deserialize<List<Timesheet>>(responseBody);
                        //string stopRight;

                        foreach (Timesheet line in apiResponse)
                        {
                            //this.ComponentMetaData.FireInformation(0, "processing record Id", line.Id.ToString(), "", 0, ref fireAgain);
                            //if (line.Id == 382258) stopRight = "Now";
                            bool isDiscarded = false;
                            if (line.Discarded.HasValue) if (line.Discarded.Value) isDiscarded = true;



                            TimesheetBuffer.AddRow();

                            TimesheetBuffer.Discarded = isDiscarded;
                            TimesheetBuffer.Invoiced = line.Invoiced;
                            if (!String.IsNullOrEmpty(line.InvoiceComment)) TimesheetBuffer.InvoiceComment = line.InvoiceComment;
                            TimesheetBuffer.Paid = line.PayStaged;

                            TimesheetBuffer.AgreementId = line.EmployeeAgreement;
                            TimesheetBuffer.AutoPayApproved = line.AutoPayRuleApproved;
                            TimesheetBuffer.AutoProcessed = line.AutoProcessed;
                            TimesheetBuffer.AutoTimeApproved = line.AutoTimeApproved;
                            TimesheetBuffer.EmployeeId = line.Employee;
                            if (line.Exported.HasValue) TimesheetBuffer.Exported = line.Exported.Value;
                            TimesheetBuffer.Id = line.Id;
                            if (line.IsInProgress.HasValue) TimesheetBuffer.InProgress = line.IsInProgress.Value;
                            if (line.PayRuleApproved.HasValue) TimesheetBuffer.PayApproved = line.PayRuleApproved.Value;
                            TimesheetBuffer.PayCycleId = line.PaycycleId;
                            TimesheetBuffer.RealTime = line.RealTime;
                            TimesheetBuffer.TimeApproved = line.TimeApproved;
                            if (line.Cost.HasValue) TimesheetBuffer.timesheetCost = line.Cost.Value;
                            TimesheetBuffer.timesheetEnd = ConvertTimeZone(UnixTimeStampToDateTime(line.EndTime), sourceTimeZone, timeZone);
                            TimesheetBuffer.timesheetHours = line.TotalTime;
                            TimesheetBuffer.timesheetStart = ConvertTimeZone(UnixTimeStampToDateTime(line.StartTime), sourceTimeZone, timeZone);
                            TimesheetBuffer.Modified = line.Modified;
                            TimesheetBuffer.Created = line.Created;
                            TimesheetBuffer.Creator = line._DPMetaData.CreatorInfo.DisplayName;

                            string SourceType = "Unplanned";

                            if (line.LeaveRule.HasValue)
                            {
                                SourceType = "Leave";
                                TimesheetBuffer.LeaveRuleId = line.LeaveRule.Value;
                                if (line.LeaveId.HasValue) TimesheetBuffer.LeaveId = line.LeaveId.Value;
                                if (line.Roster.HasValue) TimesheetBuffer.RosterId = line.Roster.Value;

                                /*
                                    List<LeavePayLineArray> leaveLines = line.Leave.LeavePayLineArray;
                                    foreach (LeavePayLineArray leaveline in leaveLines)
                                    {
                                        if (leaveline.Date == line.Date)
                                        {
                                            TimesheetBuffer.LeaveRuleId = leaveline.LeaveRule;
                                            TimesheetBuffer.LeaveLineId = leaveline.Id;
                                        }
                                    }
                                */
                            }
                            else if (line.Roster.HasValue)
                            {
                                SourceType = "Roster";
                                TimesheetBuffer.RosterId = line.Roster.Value;
                            }

                            TimesheetBuffer.SourceType = SourceType;

                            if (line.CustomFieldDataObject != null)
                            {
                                CustomFieldDataObject cust = line.CustomFieldDataObject;
                                double doubleTest = 0;
                                if (double.TryParse(cust.emsminutes, out doubleTest)) TimesheetBuffer.EMSMinutes = double.Parse(cust.emsminutes);
                                if (double.TryParse(cust.ncrminutes, out doubleTest)) TimesheetBuffer.NCRMinutes = double.Parse(cust.ncrminutes);
                                if (!String.IsNullOrEmpty(cust.purchaseorder)) TimesheetBuffer.PONumber = cust.purchaseorder;
                                if (!String.IsNullOrEmpty(cust.ritmtimesheet)) TimesheetBuffer.RITM = cust.ritmtimesheet;
                            }

                            if (line.OperationalUnit.HasValue)
                            {
                                TimesheetBuffer.AreaId = line.OperationalUnit.Value;
                                if (line.OperationalUnitObject != null) if (!String.IsNullOrEmpty(line.OperationalUnitObject.PayrollExportName)) TimesheetBuffer.JobCode = line.OperationalUnitObject.PayrollExportName;
                            }

                        }

                        if (apiResponse.Count == 500)
                        {
                            start += 500;
                        }
                        else
                        {
                            moreRecords = false;
                        }
                    }
                    else
                    {
                        ErrorObject err = sr.Deserialize<ErrorObject>(depResponse.Content.ReadAsStringAsync().Result);
                        this.ComponentMetaData.FireError(0, "API Error", err.error.code + " : " + err.error.message, "", 0, out fireAgain);
                        moreRecords = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            // Handle exceptions and log errors
            bool fireAgain = false;
            this.ComponentMetaData.FireError(0, "Script Error", ex.Message, "", 0, out fireAgain);
        }
    }
    #region functions
    private static async Task<HttpResponseMessage> apiRequest(HttpClient c, string url, StringContent req)
    {
        var reqMessage = new HttpRequestMessage(HttpMethod.Post, url);
        reqMessage.Content = req;
        HttpResponseMessage resp = await c.SendAsync(reqMessage);
        return resp;
    }

    static DateTime ConvertTimeZone(DateTime dateTime, string sourceTimeZoneId, string targetTimeZoneId)
    {
        // Find source and target time zones
        TimeZoneInfo sourceTimeZone = TimeZoneInfo.FindSystemTimeZoneById(sourceTimeZoneId);
        TimeZoneInfo targetTimeZone = TimeZoneInfo.FindSystemTimeZoneById(targetTimeZoneId);

        // Convert the original DateTime to UTC based on the source time zone
        DateTime sourceTime = DateTime.SpecifyKind(dateTime, DateTimeKind.Unspecified);
        DateTime dtUTC = TimeZoneInfo.ConvertTimeToUtc(sourceTime, sourceTimeZone);

        // Convert the UTC time to the target time zone
        DateTime targetTime = TimeZoneInfo.ConvertTimeFromUtc(dtUTC, targetTimeZone);

        return targetTime;
    }

    static DateTime ConvertUTCToTimeZone(DateTime dateTime, string timeZoneId)
    {

        DateTime dtUTC = DateTime.SpecifyKind(dateTime, DateTimeKind.Utc);
        TimeZoneInfo targetTimeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
        DateTime targetTime = TimeZoneInfo.ConvertTimeFromUtc(dtUTC, targetTimeZone);
        return targetTime;

    }

    public static DateTime UnixTimeStampToDateTime(double unixTimeStamp)
    {
        // Unix timestamp is seconds past epoch
        DateTime dateTime = new DateTime(1970, 1, 1, 0, 0, 0, 0, DateTimeKind.Utc);
        dateTime = dateTime.AddSeconds(unixTimeStamp).ToLocalTime();
        return dateTime;
    }
    #endregion

