        DTS:Name="Disable">@[$Project::ETL_VAR_DATA_RANGE_MODE] == "DELTA"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE @dateFrom date = ?;&#xA;&#xA;DELETE FROM staging.FCT_DEP_TIMESHEET&#xA;WHERE Cast(timesheetStart as date) &gt;= @dateFrom;&#xA;&#xA;INSERT INTO staging.FCT_DEP_TIMESHEET ([Id]&#xA;      ,[AgreementId]&#xA;      ,[EmployeeId]&#xA;      ,[LeaveRuleId]&#xA;      ,[LeaveId]&#xA;      ,[PayCycleId]&#xA;      ,[AreaId]&#xA;      ,[RosterId]&#xA;      ,[JobCode]&#xA;      ,[timesheetStart]&#xA;      ,[timesheetEnd]&#xA;      ,[timesheetHours]&#xA;      ,[timesheetCost]&#xA;      ,[SourceType]&#xA;      ,[InProgress]&#xA;      ,[RealTime]&#xA;      ,[AutoProcessed]&#xA;      ,[PayApproved]&#xA;      ,[TimeApproved]&#xA;      ,[AutoPayApproved]&#xA;      ,[AutoTimeApproved]&#xA;      ,[Exported]&#xA;      ,[Paid]&#xA;      ,[Invoiced]&#xA;      ,[InvoiceComment]&#xA;      ,[Discarded]&#xA;      ,[PONumber]&#xA;      ,[RITM]&#xA;      ,[EMSMinutes]&#xA;      ,[NCRMinutes]&#xA;      ,[Modified])&#xA;SELECT [Id]&#xA;      ,[AgreementId]&#xA;      ,[EmployeeId]&#xA;      ,[LeaveRuleId]&#xA;      ,[LeaveId]&#xA;      ,[PayCycleId]&#xA;      ,[AreaId]&#xA;      ,[RosterId]&#xA;      ,[JobCode]&#xA;      ,[timesheetStart]&#xA;      ,[timesheetEnd]&#xA;      ,[timesheetHours]&#xA;      ,[timesheetCost]&#xA;      ,[SourceType]&#xA;      ,[InProgress]&#xA;      ,[RealTime]&#xA;      ,[AutoProcessed]&#xA;      ,[PayApproved]&#xA;      ,[TimeApproved]&#xA;      ,[AutoPayApproved]&#xA;      ,[AutoTimeApproved]&#xA;      ,[Exported]&#xA;      ,[Paid]&#xA;      ,[Invoiced]&#xA;      ,[InvoiceComment]&#xA;      ,[Discarded]&#xA;      ,[PONumber]&#xA;      ,[RITM]&#xA;      ,[EMSMinutes]&#xA;      ,[NCRMinutes]&#xA;      ,[Modified] &#xA;&#x9;  FROM staging.DEP_Timesheet;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_CUS_REBUILD_DATE"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
