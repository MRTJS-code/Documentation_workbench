    <DTS:Executable
      DTS:refId="Package\FACT Timesheet"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7B758BE2-5F69-4A6C-8A21-6956CE5ADB0C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="FACT Timesheet"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;t.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;d.SK_DIM_DATE FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.SK_FACT_ROSTER FK_DIM_ROSTER,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(g.SK_DIM_SECURITYGUARD,0) FK_DIM_GUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN a.PK_DeputyId is not NULL THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE isnull(lt.SK_DIM_LEAVETYPE,0) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END FK_DIM_LEAVETYPE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN lt.SK_DIM_LEAVETYPE is not NULL THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE isnull(a.PK_DeputyId,0)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(ga.PK_DeputyId,0) FK_DIM_AGREEMENT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PONumber,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.EMSMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.NCRMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetHours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.timesheetCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--a.AreaJobSalesPerHour,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;a.AreaSiteRate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ep.P_Base_Rate baseHrRate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.SourceType,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RealTime,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AutoTimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.AutoPayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TimeApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PayApproved,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Exported,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Paid,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Invoiced,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.InvoiceComment,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Discarded,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE t.PayCycleId&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN NULL THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END hasPayCylcle,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Created,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Modified,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(NULL as datetime) MD_ExportedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(NULL as datetime) MD_PaidDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(NULL as datetime) MD_InvoicedDate&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_Timesheet t&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_DATE d ON CAST(t.timesheetStart as date) = d.PK_Date&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.FACT_ROSTER r ON t.RosterId = r.PK_SourceId AND r.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_SECURITYGUARD g ON t.EmployeeId = g.PK_SourceId AND g.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_LEAVETYPE lt ON t.LeaveRuleId = lt.PK_SourceId AND lt.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_AREA a ON t.AreaId = a.PK_DeputyId&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_GUARDAGREEMENT ga ON t.AgreementId = ga.PK_DeputyId AND ga.AgreeActive = 1&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE e ON ga.FK_DIM_EMPLOYEE = e.SK_DIM_EMPLOYEE&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE_PAY ep ON e.SK_DIM_EMPLOYEE = ep.FK_DIM_EMPLOYEE;&#xA;&#xA;&#xA;-- Below logic will add dates where exported, final or invoiced appear for the first time or clear these dates if these fields revert to false&#xA;-- If target has MD for exported, final or invoiced and this aligns to source exported/final/invoiced values add these dates to source.  Otherwise leave the date MD fields as NULL&#xA;-- If source is exported and target is not then capture exported date (modified)&#xA;-- If source is paid and target is not final then caputre final date (modified)&#xA;-- If source is invoiced and target is not  then capture invoiced date (modified)&#xA;WITH qry as (&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Exported = 1 AND t.MD_ExportedDate is NOT NULL THEN t.MD_ExportedDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Exported = 1 THEN s.Modified&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END MD_ExportedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Paid = 1 AND t.MD_FinalDate is NOT NULL THEN t.MD_FinalDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Paid = 1 THEN s.Modified&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END MD_FinalDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Invoiced = 1 AND t.MD_InvoicedDate is NOT NULL THEN t.MD_InvoicedDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN s.Invoiced = 1 THEN s.Modified&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END MD_InvoicedDate&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.FACT_TIMESHEET t ON s.Id = t.PK_DeputyId)&#xA;UPDATE&#x9;&#x9;&#x9;&#x9;&#x9;s&#xA;SET&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.MD_ExportedDate = qry.MD_ExportedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.MD_PaidDate = qry.MD_FinalDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.MD_InvoicedDate = qry.MD_InvoicedDate&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;INNER JOIN&#x9;&#x9;&#x9;&#x9;qry ON s.Id = qry.Id;&#xA;&#xA;&#xA;-- Merge into Timesheet&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.FACT_TIMESHEET t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_DeputyId = s.Id&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_DATE,0) != isnull(s.FK_DIM_DATE,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_FACT_ROSTER,0) != isnull(s.FK_DIM_ROSTER,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_SECURITYGUARD,0) != isnull(s.FK_DIM_GUARD,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_GUARDAGREEMENT,0) != isnull(s.FK_DIM_AGREEMENT,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_LEAVE_TYPE,0) != isnull(s.FK_DIM_LEAVETYPE,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_AREA,0) != isnull(s.FK_DIM_AREA,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMRosterId,0) != isnull(s.RosterId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMGuardId,0) != isnull(s.EmployeeId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMPurchaseOrder,'') != isnull(s.PONumber,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMRITM,'') != isnull(s.RITM,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMEMSMinutes,0) != isnull(s.EMSMinutes,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMNCRMinutes,0) != isnull(s.NCRMinutes,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMDateFrom,'1900-01-01') != isnull(s.timesheetStart,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMDateTo,'1900-01-01') != isnull(s.timesheetEnd,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMHours,0) != isnull(s.timesheetHours,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMCost,0) != isnull(s.timesheetCost,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMJobCostPerHour,0) != isnull(s.AreaSiteRate,0)&#xA;--OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMJobSalesPerHour,0) != isnull(s.AreaJobCostHrOverride,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMBaseCostPerHour,0) != isnull(s.baseHrRate,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMSourceType,'') != isnull(s.SourceType,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMRealTime,0) != isnull(s.RealTime,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMAutoTimeApproved,0) != isnull(s.AutoTimeApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMAutoPayApproved,0) != isnull(s.AutoPayApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMTimeApproved,0) != isnull(s.TimeApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMPayApproved,0) != isnull(s.PayApproved,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMExported,0) != isnull(s.Exported,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMFinal,0) != isnull(s.Paid,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMInvoiced,0) != isnull(s.Invoiced,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMInvoiceRef,'') != isnull(s.InvoiceComment,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMDiscarded,0) != isnull(s.Discarded,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.TMHasPayCycle,0) != isnull(s.hasPayCylcle,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.MD_ExportedDate,'1900-01-01') != isnull(s.MD_ExportedDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.MD_FinalDate,'1900-01-01') != isnull(s.MD_PaidDate,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.MD_InvoicedDate,'1900-01-01') != isnull(s.MD_InvoicedDate,'1900-01-01'))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_DATE = s.FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_FACT_ROSTER = s.FK_DIM_ROSTER,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_SECURITYGUARD = s.FK_DIM_GUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_GUARDAGREEMENT = s.FK_DIM_AGREEMENT,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_LEAVE_TYPE = s.FK_DIM_LEAVETYPE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_AREA = s.FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMRosterId = s.RosterId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMGuardId = s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMPurchaseOrder = s.PONumber,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMRITM = s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMEMSMinutes = s.EMSMinutes,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.TMNCRMinutes = 