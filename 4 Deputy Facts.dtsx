  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\FACT Roster"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E30F5ECD-4B07-43A5-8165-B82EECE2213B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="FACT Roster"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34FC873D-0671-4069-BE95-2B61D00A6202}"
          SQLTask:SqlStatementSource="DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode int = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun bigint = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@ETLType varchar(10) = ?;&#xA;DECLARE&#x9;&#x9;&#x9;&#x9;&#x9;@FixedDate datetime = ?;&#xA;&#xA;SELECT&#x9;&#x9;&#x9;&#x9;&#x9;r.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(d.SK_DIM_DATE,0) FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(g.SK_DIM_SECURITYGUARD,0) FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(a.PK_DeputyId,0) FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.PK_DeputyId,r.TimesheetId) FK_FACT_TIMESHEET,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;null salesHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN isnull(ct.TierPayRate,0) &gt;0 THEN ct.TierPayRate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN wa.PayRate &gt; ep.P_Base_Rate THEN wa.PayRate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE ep.P_Base_Rate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END costHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Cost DepTotalCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LEFT(r.Warning,100) Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN r.WarningOverride is NULL THEN 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE 1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN CHARINDEX(' on ',r.WarningOverride) = 0 OR r.WarningOverride is NULL THEN NULL&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ELSE SUBSTRING(r.WarningOverride,13, CHARINDEX(' on ',r.WarningOverride)-12) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;END OverrideBy,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LEFT(r.PurchaseOrder,100) PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;LEFT(r.RITM,100) RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;r.ModifiedDate&#xA;INTO&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild&#xA;FROM&#x9;&#x9;&#x9;&#x9;&#x9;staging.DEP_ROSTER r&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_DATE d ON r.RosterDate = d.PK_Date&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_SECURITYGUARD g ON r.EmployeeId = g.PK_SourceId AND g.PK_SourceSystem = 'Deputy'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_AREA a ON r.AreaId = a.PK_DeputyId&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;lookup.DEP_ClientTiers ct on g.PK_SourceId = ct.FK_SecurityGuardID AND a.PK_DeputyId = ct.FK_WorkAreaID AND isnull(ct.EffectiveFrom, r.RosterDate) &lt;= r.RosterDate AND isnull(ct.EffectiveTo, r.RosterDate) &gt;= r.RosterDate&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;lookup.DEP_WorkAreas wa ON a.PK_DeputyId = wa.PK_WorkAreaID AND isnull(wa.EffectiveFrom,r.RosterDate) &lt;= r.RosterDate AND isnull(wa.EffectiveTo, r.RosterDate) &gt;= r.RosterDate&#xA;--LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_JOB j ON a.FK_Job = j.SK_DIM_JOB&#xA;--LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_JOB_PRICE jp ON j.FK_DIM_JOB_PRICE = jp.SK_DIM_JOB_PRICE&#xA;OUTER APPLY(&#x9;&#x9;&#x9;&#x9;SELECT TOP(1) sga.FK_DIM_SECURITYGUARD, sga.FK_DIM_EMPLOYEE &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM dw.DIM_GUARDAGREEMENT sga &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE sga.AgreeActive = 1 AND sga.FK_DIM_SECURITYGUARD = g.SK_DIM_SECURITYGUARD&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;ORDER BY sga.MD_ModifiedDate, sga.PK_DeputyId&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;) ga&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE e ON ga.FK_DIM_EMPLOYEE = e.SK_DIM_EMPLOYEE AND e.PK_DW_Source_System = 'Preceda'&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.DIM_EMPLOYEE_PAY ep ON e.SK_DIM_EMPLOYEE = ep.FK_DIM_EMPLOYEE&#xA;LEFT JOIN&#x9;&#x9;&#x9;&#x9;dw.FACT_TIMESHEET t ON r.TimesheetId = t.PK_DeputyId&#xA;&#xA;MERGE INTO&#x9;&#x9;&#x9;&#x9;dw.FACT_ROSTER t&#xA;USING&#x9;&#x9;&#x9;&#x9;&#x9;#sourceBuild s&#xA;ON&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.PK_SourceId = s.Id AND t.PK_SourceSystem = 'Deputy'&#xA;&#xA;WHEN MATCHED AND (&#x9;&#x9;isnull(t.FK_DIM_DATE,0) != isnull(s.FK_DIM_DATE,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_SECURITYGUARD,0) != isnull(s.FK_DIM_SECURITYGUARD,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_DIM_AREA,0) != isnull(s.FK_DIM_AREA,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.FK_FACT_TIMESHEET,0) != isnull(s.FK_FACT_TIMESHEET,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterGuardId,0) != isnull(s.EmployeeId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterAreaId,0) != isnull(s.AreaId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterTimesheetId,0) != isnull(s.TimesheetId,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterFrom,'1900-01-01') != isnull(s.RosterStart,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterTo,'1900-01-01') != isnull(s.RosterEnd,'1900-01-01')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterHrs,0) != isnull(s.Hours,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterSalesPerHr,0) != isnull(s.salesHr,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterCostPerHr,0) != isnull(s.costHr,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterTotalCost,0) != isnull(s.DepTotalCost,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterWarning,'') != isnull(s.Warning,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterWarningOr,0) != isnull(s.WarningOverride,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterWarningOrBy,'') != isnull(s.OverrideBy,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterPublished,0) != isnull(s.Published,0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterOpen,0) != isnull(s.[Open],0)&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterPO,'') != isnull(s.PurchaseOrder,'')&#xA;OR&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;isnull(t.RosterRITM,'') != isnull(s.RITM,''))&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.FK_DIM_DATE = s.FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_SECURITYGUARD = s.FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_DIM_AREA = s.FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.FK_FACT_TIMESHEET = s.FK_FACT_TIMESHEET,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterGuardId = s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterAreaId = s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterTimesheetId = s.TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterFrom = s.RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterTo = s.RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterHrs = s.Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterSalesPerHr = s.salesHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterCostPerHr = s.costHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterTotalCost = s.DepTotalCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterWarning = s.Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterWarningOr = s.WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterWarningOrBy = s.OverrideBy,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterPublished = s.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterOpen = s.[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterPO = s.PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.RosterRITM = s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = s.ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLJobCode = @ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRunCode = @ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ETLRun = @ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedUser = s.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_LogicalDelete = 0&#xA;&#xA;WHEN NOT MATCHED&#xA;THEN INSERT (&#x9;&#x9;&#x9;PK_SourceSystem,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;PK_SourceId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FK_FACT_TIMESHEET,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterGuardId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterAreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterTimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterFrom,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterTo,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterHrs,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterSalesPerHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterCostPerHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterTotalCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterWarning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterWarningOr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterWarningOrBy,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterPublished,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterOpen,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterPO,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;RosterRITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_CreateDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_ModifiedUser,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;MD_LogicalDelete)&#xA;VALUES (&#x9;&#x9;&#x9;&#x9;'Deputy',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Id,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_DATE,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_SECURITYGUARD,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_DIM_AREA,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.FK_FACT_TIMESHEET,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.EmployeeId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.AreaId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.TimesheetId,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterStart,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.RosterEnd,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Hours,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.salesHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.costHr,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.DepTotalCost,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Warning,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.WarningOverride,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.OverrideBy,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Published,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.[Open],&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.PurchaseOrder,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.RITM,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.ModifiedDate,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLJobCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRunCode,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLRun,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;s.Creator,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;0)&#xA;&#xA;WHEN NOT MATCHED BY SOURCE&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;@ETLType = 'Fixed'&#xA;AND&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;CAST(t.rosterFrom as Date) &gt;= @FixedDate&#xA;THEN UPDATE SET&#x9;&#x9;&#x9;t.MD_LogicalDelete = 1,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;t.MD_ModifiedDate = SYSDATETIME();" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Project::ETL_VAR_JOB_CODE"
