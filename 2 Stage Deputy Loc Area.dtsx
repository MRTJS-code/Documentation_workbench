        }
    }

    public String ENVCONNECTION1DEPURL
    {
        get
        {
            return (String)(ParentComponent.ReadOnlyVariables["ENV_CONNECTION_1_DEP_URL"].GetValueWithContext(ScriptComponent.EvaluatorContext));
        }
    }

}
